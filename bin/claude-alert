#!/usr/bin/env python3
"""Claude Code hook: tell the user a session needs them.

  claude-alert notify  (Notification hook) Windows pop-up + bell mark on the tmux window
  claude-alert clear   (UserPromptSubmit / PostToolUse hooks) remove the bell mark

The mark is the tmux window option @claude_attn, shown by window-status-format
(see tmux.conf). Background sessions have no tmux pane, so they only get the pop-up.
"""
import json
import os
import subprocess
import sys

POWERSHELL = "/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe"
# PowerShell's own app id: toasts from an unregistered app id are dropped by Windows.
APP_ID = r"{1AC14E77-02E7-4E5D-B744-2EB1AE5198B7}\WindowsPowerShell\v1.0\powershell.exe"


def tmux(*args):
    return subprocess.run(["tmux", *args], capture_output=True, text=True).stdout.strip()


def ps_quote(s):
    return "'" + s.replace("'", "''") + "'"


def toast(title, body):
    script = (
        "[Windows.UI.Notifications.ToastNotificationManager, Windows.UI.Notifications, ContentType = WindowsRuntime] > $null;"
        "$x = [Windows.UI.Notifications.ToastNotificationManager]::GetTemplateContent([Windows.UI.Notifications.ToastTemplateType]::ToastText02);"
        "$t = $x.GetElementsByTagName('text');"
        f"$t.Item(0).AppendChild($x.CreateTextNode({ps_quote(title)})) > $null;"
        f"$t.Item(1).AppendChild($x.CreateTextNode({ps_quote(body)})) > $null;"
        f"[Windows.UI.Notifications.ToastNotificationManager]::CreateToastNotifier({ps_quote(APP_ID)})"
        ".Show([Windows.UI.Notifications.ToastNotification]::new($x))"
    )
    # Detached so the hook returns at once; PowerShell takes about a second to start.
    subprocess.Popen([POWERSHELL, "-NoProfile", "-NonInteractive", "-Command", script],
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)


def main():
    action = sys.argv[1] if len(sys.argv) > 1 else "notify"
    pane = os.environ.get("TMUX_PANE")

    if action == "clear":
        if pane:
            tmux("set", "-wu", "-t", pane, "@claude_attn")
        return

    try:
        event = json.load(sys.stdin)
    except ValueError:
        event = {}
    message = event.get("message") or "Claude needs you"
    where = os.path.basename(event.get("cwd") or "") or "Claude"
    if pane:
        tmux("set", "-w", "-t", pane, "@claude_attn", "1")
        where = tmux("display", "-p", "-t", pane, "#S:#I #W")
    toast(f"Claude · {where}", message)


if __name__ == "__main__":
    main()
