#!/bin/sh
# ws: open the tmux workspace.
# tmux running -> attach to it. Not running (e.g. after a shutdown) -> start tmux,
# restore the last saved layout (tmux-resurrect; Claude panes per resurrect-claude.py), attach.
if [ -n "$TMUX" ]; then
  echo "ws: already inside tmux"; exit 0
fi
if tmux has-session 2>/dev/null; then
  exec tmux attach
fi
tmux new-session -d   # fresh server with the default session "0", which resurrect restores into
if [ -e "$HOME/.local/share/tmux/resurrect/last" ]; then
  echo "ws: restoring the last saved workspace..."
  tmux run-shell "$HOME/.config/tmux/plugins/tmux-resurrect/scripts/restore.sh"
fi
exec tmux attach
