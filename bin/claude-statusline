#!/usr/bin/env python3
# Claude Code status line: rounded Catppuccin Mocha "pills" (like the tmux bar)
# showing the session's directory, its git branch and how full its context window is.
# Also saves the account's 5-hour and 7-day usage limits to ~/.cache/claude-limits.json,
# which the tmux bar reads (~/.config/tmux/scripts/sysinfo.sh).
# Wired up via "statusLine" in ~/.claude/settings.json.
import json, os, re, subprocess, sys, tempfile, time

CRUST = (17, 17, 27)
LAVENDER = (180, 190, 254)
MAUVE = (203, 166, 247)
OVERLAY, YELLOW, RED = (127, 132, 156), (249, 226, 175), (243, 139, 168)
LIMITS = os.path.expanduser("~/.cache/claude-limits.json")
LEFT, RIGHT = "", ""   # rounded powerline caps (Nerd Font)
FOLDER, BRANCH = "\U000f024b", ""


def fg(c): return "\033[38;2;%d;%d;%dm" % c
def bg(c): return "\033[48;2;%d;%d;%dm" % c


def pill(color, text):
    return f"{fg(color)}{LEFT}{bg(color)}{fg(CRUST)}\033[1m{text}\033[0m{fg(color)}{RIGHT}\033[0m"


data = json.load(sys.stdin)
cwd = (data.get("workspace") or {}).get("current_dir") or data.get("cwd") or os.getcwd()

home = os.path.expanduser("~")
shown = "~" + cwd[len(home):] if cwd == home or cwd.startswith(home + "/") else cwd
parts = [pill(LAVENDER, f"{FOLDER} {shown}")]

try:
    branch = subprocess.run(["git", "-C", cwd, "branch", "--show-current"],
                            capture_output=True, text=True, timeout=1).stdout.strip()
except Exception:
    branch = ""
if branch:
    parts.append(pill(MAUVE, f"{BRANCH} {branch}"))

# Context use as quiet text at the right edge: grey until it gets high, then yellow (50%+) or red (80%+).
ctx = (data.get("context_window") or {}).get("used_percentage")
right = ""
if ctx is not None:
    color = OVERLAY if ctx < 50 else YELLOW if ctx < 80 else RED
    right = f"{fg(color)}{ctx:.0f}% context\033[0m"

# Usage limits come with every API response for claude.ai subscribers; keep the latest for tmux.
limits = {k: v for k, v in (data.get("rate_limits") or {}).items() if k in ("five_hour", "seven_day")}
if limits:
    try:
        os.makedirs(os.path.dirname(LIMITS), exist_ok=True)
        with tempfile.NamedTemporaryFile("w", dir=os.path.dirname(LIMITS), delete=False) as f:
            json.dump({"saved_at": time.time(), **limits}, f)
        os.replace(f.name, LIMITS)
    except OSError:
        pass

left = " ".join(parts)
# Claude Code sets COLUMNS to the terminal width; pad so the context text sits at the right edge.
visible = lambda t: len(re.sub(r"\033\[[0-9;]*m", "", t))
gap = int(os.environ.get("COLUMNS", 0) or 0) - visible(left) - visible(right) - 4
print(left + " " * max(gap, 2) + right if right else left)
